      "startupObjectId": 0,
      "breakOnNext": "WebClient",
      "launchBrowser": true,
      "enableLongRunningSqlStatements": true,
      "enableBreakpointDebugging": true,
      "server": "localhost",
      "port": 7049,
      "authentication": "UserPassword",
      "schemaUpdateMode": "ForceSync"
    }
