{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PensionBridge": "Server=localhost;Database=PensionBridge;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Authentication": {
    "Authority": "https://login.microsoftonline.com/your-tenant-id",
    "Audience": "api://your-api-identifier"
  },
  "BusinessCentral": {
    "BaseUrl": "https://api.businesscentral.dynamics.com",
    "TokenUrl": "https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "Scope": "https://api.businesscentral.dynamics.com/.default",
    "CompanyId": "your-company-id"
  }
}
