# Database Configuration
ConnectionStrings__PensionBridge=Server=localhost,1433;Database=PensionBridge;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# Business Central Configuration
BusinessCentral__BaseUrl=https://api.businesscentral.dynamics.com/v2.0/
BusinessCentral__TenantId=your-tenant-id
BusinessCentral__Environment=Production
BusinessCentral__CompanyId=your-company-id
BusinessCentral__ClientId=your-client-id
BusinessCentral__ClientSecret=your-client-secret
BusinessCentral__ApiVersion=v2.0

# Authentication Configuration
Authentication__Authority=https://login.microsoftonline.com/your-tenant-id
Authentication__Audience=api://your-api-identifier

# Logging Configuration
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

# File Storage
FileStorage__Path=./uploads
FileStorage__MaxFileSizeMB=100
